  height: 102px;
  background-image: url("https://64.media.tumblr.com/57c1bd961194a7b66eabc79cff5cc583/225a568197be9218-52/s1280x1920/0249b9ab528b519a68a52d038808f973fcd7f2ab.png");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.splash .favorite {
  position: relative;
}

.splash .favorite::after {
  content: " 𝑳𝒐𝒐𝒌, 𝑺𝒐𝒌𝒌𝒂, 𝒚𝒐𝒖'𝒓𝒆 𝒈𝒐𝒊𝒏𝒈 𝒕𝒐 𝒇𝒂𝒊𝒍 𝒂 𝒍𝒐𝒕 𝒃𝒆𝒇𝒐𝒓𝒆 𝒕𝒉𝒊𝒏𝒈𝒔 𝒘𝒐𝒓𝒌 𝒐𝒖𝒕. ";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  transform: translateY(16px);
  border-radius: 10px;
  background: rgba(25, 23, 21, 0.7);
  text-align: center;
  font-size: 12px;
  color: #D6DCE5;
  opacity: 1;
  white-space: pre;
}

